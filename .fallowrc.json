{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "packages": ["apps/*", "packages/*"]
  },
  "entry": [
    "apps/web/vite.config.ts",
    "apps/web/src/sw/service-worker.ts",
    "apps/web/src/**/*.test.ts",
    "packages/backend/vitest.config.ts",
    "packages/dev-stack/src/cli.ts",
    "apps/extension/wxt.config.ts",
    "apps/extension/src/entrypoints/**/*.{ts,tsx}",
    "apps/extension/src/**/*.test.ts",
    "packages/dev-stack/src/**/*.test.ts"
  ],
  "ignorePatterns": ["**/_generated/**", "**/routeTree.gen.ts"],
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ui/**",
      "exports": ["*"]
    },
    {
      "file": "apps/extension/src/components/ui/**",
      "exports": ["*"]
    }
  ]
}
