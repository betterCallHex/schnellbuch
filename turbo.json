{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.local"],
  "globalPassThroughEnv": [
    "CONVEX_DEPLOYMENT",
    "VITE_CONVEX_URL",
    "VITE_CONVEX_SITE_URL",
    "VITE_SITE_URL",
    "WXT_SCHNELLBUCH_URL",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "PORT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".vercel/output/**", "dist/**"]
    },
    "typecheck": {},
    "test": {
      "cache": false
    },
    "routes:generate": {
      "cache": false
    }
  }
}
