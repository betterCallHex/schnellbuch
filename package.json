{
  "name": "schnellbuch",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "bun packages/backend/scripts/dev-setup.ts && turbo run dev",
    "dev:verify": "bun packages/dev-stack/src/cli.ts",
    "fallow": "fallow dead-code",
    "routes:generate": "turbo run routes:generate",
    "smoke": "bun packages/dev-stack/src/smoke.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "convex": "1.50.0",
    "fallow": "3.43.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "ultracite": "8.2.0"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "@convex-dev/better-auth@0.13.0": "patches/@convex-dev%2Fbetter-auth@0.13.0.patch"
  }
}
