    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "fallow": "3.43.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "ultracite": "8.2.0"
  },
  "packageManager": "bun@1.4.3"
}
