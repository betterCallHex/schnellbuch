{
  "name": "schnellbuch",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "turbo run dev",
