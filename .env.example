# The one env file for the whole repo. Copy it to .env.local at the repo root
# (`bun run dev` does that on first run and generates BETTER_AUTH_SECRET).
# Every app and package reads .env.local from here; there are no per-package
# env files.

# Convex: `bun run dev` fills these in when it sets up your dev deployment.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Web app (apps/web).
VITE_SITE_URL=http://localhost:3000

# Backend settings. `bun run dev` pushes them to your Convex dev deployment
# before every start; an empty value removes it there.
# BETTER_AUTH_SECRET: at least 32 characters, signs every session.
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000
MCP_CONSENT_URL=http://localhost:3000/connect
# Who may create an account: comma-separated addresses (me@example.com) or
# whole domains (@example.com), case-insensitive. Empty closes sign-ups;
# existing accounts always keep signing in.
SIGNUP_ALLOWED_EMAILS=
# Sign-in codes go out through Brevo's transactional email API (free: 300 a day).
# BREVO_API_KEY: an API key from Brevo's SMTP & API settings.
# EMAIL_FROM: a sender address verified in Brevo, e.g. you@gmail.com.
# Leave either empty and codes are written to the Convex logs instead.
BREVO_API_KEY=
EMAIL_FROM=

# Browser extension (apps/extension), read at build time: the SchnellBuch
# address it saves to until the user picks another on its options page.
WXT_SCHNELLBUCH_URL=http://localhost:3000

# Production smoke check (bun run smoke), all read-only.
SMOKE_SITE_URL=
SMOKE_MCP_URL=
SMOKE_MCP_KEY=

# Never put CONVEX_DEPLOY_KEY here: it belongs in Vercel's settings, and the
# Convex CLI would use it to reach production.
