# packages/backend/.env.local is written by `bun run dev` (convex dev) on first run.
# Production (Vercel) sets these directly:
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_SITE_URL=http://localhost:3000

# Backend settings live on the Convex deployment, not in this file:
#   bunx convex env set <NAME> <value>   (from packages/backend)
# BETTER_AUTH_SECRET=     at least 32 characters, signs every session
# SITE_URL=               the web app's URL, e.g. http://localhost:3000
# MCP_CONSENT_URL=        <SITE_URL>/connect
# SIGNUP_ALLOWED_EMAILS=  who may create an account: comma-separated addresses
#                         (me@example.com) or whole domains (@example.com),
#                         case-insensitive. Empty or unset closes sign-ups;
#                         existing accounts always keep signing in.
